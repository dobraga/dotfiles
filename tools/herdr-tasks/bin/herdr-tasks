#!/usr/bin/env bash
set -euo pipefail

# Resolve symlinks to find tools/herdr-tasks/bin/herdr-tasks
SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" >/dev/null 2>&1 && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ "$SOURCE" != /* ]] && SOURCE="$DIR/$SOURCE"
done
SCRIPT_DIR="$(cd -P "$(dirname "$SOURCE")" >/dev/null 2>&1 && pwd)"
ROOT="$(cd "${SCRIPT_DIR}/.." >/dev/null 2>&1 && pwd)"

BUN_BIN="${HOME}/.bun/bin/bun"
if [ ! -x "${BUN_BIN}" ]; then
  BUN_BIN="$(command -v bun || true)"
fi
if [ -z "${BUN_BIN}" ] || [ ! -x "${BUN_BIN}" ]; then
  echo "herdr-tasks: bun runtime not found. Install bun." >&2
  exit 1
fi

# argv[1] is the CLI path so the CLI can re-launch itself (detached runs) and find this wrapper.
exec "${BUN_BIN}" "${ROOT}/src/cli.ts" "$@"
